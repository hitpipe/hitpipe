    "NormalizedSignal": {
      "additionalProperties": false,
      "description": "Minimal whitelist; no arbitrary metadata, customer/contact/brief. Event signature verified before durable intake, same account+mode bounded and immutable. Digest computed over canonical payload excluding message_digest.",
