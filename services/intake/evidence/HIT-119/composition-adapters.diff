-	srv.SetKeepAlivesEnabled(false)
-	return &Server{srv, t}, nil
+	}), nil
@@ -120,0 +129,10 @@ func New(address, processingDNS string, cfg *tls.Config, service *app.Service, b
+
+func processingPeer(c *tls.ConnectionState, name string) bool {
+	if c == nil || c.Version != tls.VersionTLS13 || len(c.VerifiedChains) == 0 || len(c.PeerCertificates) == 0 {
+		return false
+	}
+	leaf := c.PeerCertificates[0]
+	return len(leaf.DNSNames) == 1 && leaf.DNSNames[0] == name &&
+		len(leaf.URIs) == 0 && len(leaf.IPAddresses) == 0
+}
+
