@@ -95,0 +91,15 @@ func New(cfg *tls.Config, timeout time.Duration, installs Installations, gate St
+// NewHandler exposes the signed route for the shared Intake listener.
+func NewHandler(timeout time.Duration, installs Installations, gate StartGate, receivers map[string]*receivesignal.Consumer) (http.Handler, error) {
+	if timeout <= 0 || missing(installs) || missing(gate) || len(receivers) == 0 {
+		return nil, errors.New("webhook dependencies required")
+	}
+	owners := make(map[string]*receivesignal.Consumer, len(receivers))
+	for workspace, receiver := range receivers {
+		if workspace == "" || receiver == nil {
+			return nil, errors.New("invalid workspace receiver")
+		}
+		owners[workspace] = receiver
+	}
+	return handler{timeout: timeout, installs: installs, gate: gate, receivers: owners}, nil
+}
