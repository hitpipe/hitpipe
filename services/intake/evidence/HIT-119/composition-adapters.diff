+// NewHandler keeps peer authorization at the route boundary, including when
+// another signed route on the same listener accepts connections without mTLS.
+func NewHandler(processingDNS string, service *app.Service, bodyLimit int64) (http.Handler, error) {
+	if processingDNS == "" || service == nil || bodyLimit <= 0 || bodyLimit >= 1<<31 {
+		return nil, app.Fail("dependency")
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
@@ -55 +66 @@ func New(address, processingDNS string, cfg *tls.Config, service *app.Service, b
-		if r.TLS == nil || len(r.TLS.VerifiedChains) == 0 {
