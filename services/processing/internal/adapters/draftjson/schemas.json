{
  "CommandMeta": {
    "additionalProperties": false,
    "description": "Expected revision mandatory for existing mutable aggregate; header If-Match must agree if present. Stable request ID plus body digest defines command identity.",
    "properties": {
      "expected_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "request_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "request_id"
    ],
    "type": "object"
  },
  "DraftConfig": {
    "additionalProperties": false,
    "properties": {
      "assignee_alias": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "destination_connection_id": {
        "format": "uuid",
        "type": "string"
      },
      "draft_id": {
        "format": "uuid",
        "type": "string"
      },
      "list_alias": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "mode": {
        "enum": [
          "TEST",
          "LIVE"
        ],
        "type": "string"
      },
      "name": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "price_alias": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "required_context_keys": {
        "items": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "maxItems": 20,
        "type": "array",
        "uniqueItems": true
      },
      "revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "service_label": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "source_connection_id": {
        "format": "uuid",
        "type": "string"
      },
      "title_pattern": {
        "enum": [
          "SERVICE_ORDER"
        ],
        "type": "string"
      }
    },
    "required": [
      "draft_id",
      "revision",
      "name"
    ],
    "type": "object"
  },
  "DraftWrite": {
    "additionalProperties": false,
    "properties": {
      "command": {
        "$ref": "#/components/schemas/CommandMeta"
      },
      "config": {
        "$ref": "#/components/schemas/DraftConfig"
      }
    },
    "required": [
      "command",
      "config"
    ],
    "type": "object"
  },
  "Error": {
    "additionalProperties": false,
    "description": "No secrets or other-workspace existence in error text. Unknown fields fail closed.",
    "properties": {
      "code": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "current_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "message": {
        "maxLength": 512,
        "type": "string"
      },
      "request_id": {
        "format": "uuid",
        "type": "string"
      },
      "retry_after_seconds": {
        "maximum": 3600,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "code",
      "message",
      "request_id"
    ],
    "type": "object"
  },
  "ReadinessCheck": {
    "additionalProperties": false,
    "properties": {
      "activation_preview": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ActivationPreview"
          },
          {
            "type": "null"
          }
        ],
        "description": "Обязательный объект при passed=true и ровно null при passed=false. Сервер сохраняет именно этот снимок вместе с частным BindingProof до ответа; клиент не достраивает его из aliases."
      },
      "check_id": {
        "format": "uuid",
        "type": "string"
      },
      "checked_at": {
        "format": "date-time",
        "type": "string"
      },
      "config_digest": {
        "description": "SHA-256 RFC8785 JCS значимых полей DraftConfig: исходный объект без name, draft_id и revision. Версия проверяется отдельно. Это digest черновика, а не окончательной конфигурации с разрешёнными ID.",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "draft_id": {
        "format": "uuid",
        "type": "string"
      },
      "draft_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "expires_at": {
        "format": "date-time",
        "type": "string"
      },
      "issues": {
        "items": {
          "$ref": "#/components/schemas/Error"
        },
        "maxItems": 100,
        "type": "array"
      },
      "passed": {
        "type": "boolean"
      }
    },
    "required": [
      "check_id",
      "draft_id",
      "draft_revision",
      "config_digest",
      "passed",
      "checked_at",
      "expires_at",
      "issues",
      "activation_preview"
    ],
    "type": "object"
  },
  "ScenarioExample": {
    "additionalProperties": false,
    "properties": {
      "amount_minor": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "duplicate": {
        "type": "boolean"
      },
      "missing_context_keys": {
        "items": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 20,
        "type": "array"
      },
      "paid": {
        "type": "boolean"
      },
      "synthetic_session_alias": {
        "pattern": "^example_[A-Za-z0-9_]+$",
        "type": "string"
      }
    },
    "required": [
      "synthetic_session_alias",
      "amount_minor",
      "paid",
      "duplicate",
      "missing_context_keys"
    ],
    "type": "object"
  },
  "RehearsalRequest": {
    "additionalProperties": false,
    "properties": {
      "command": {
        "$ref": "#/components/schemas/CommandMeta"
      },
      "draft_id": {
        "format": "uuid",
        "type": "string"
      },
      "draft_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "examples": {
        "items": {
          "$ref": "#/components/schemas/ScenarioExample"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
      },
      "readiness_check_id": {
        "description": "Точная успешная непросроченная проверка готовности, чей activation_preview используется в этой репетиции. Сервер не выбирает последнюю проверку автоматически.",
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "command",
      "draft_id",
      "draft_revision",
      "examples",
      "readiness_check_id"
    ],
    "type": "object"
  },
  "RehearsalResult": {
    "additionalProperties": false,
    "properties": {
      "config_digest": {
        "description": "SHA-256 RFC8785 JCS значимых полей DraftConfig: исходный объект без name, draft_id и revision. Версия проверяется отдельно. Это digest черновика, а не окончательной конфигурации с разрешёнными ID.",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "draft_id": {
        "format": "uuid",
        "type": "string"
      },
      "draft_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "live_requests_made": {
        "const": 0,
        "type": "integer"
      },
      "rehearsal_id": {
        "format": "uuid",
        "type": "string"
      },
      "results": {
        "items": {
          "enum": [
            "WOULD_CONFIRM",
            "WOULD_WAIT",
            "WOULD_EXCLUDE",
            "WOULD_HOLD_UNKNOWN"
          ],
          "type": "string"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "rehearsal_id",
      "draft_id",
      "draft_revision",
      "config_digest",
      "results",
      "live_requests_made"
    ],
    "type": "object"
  },
  "ActivationCommand": {
    "additionalProperties": false,
    "properties": {
      "acceptance_text_version": {
        "const": "managed-operation-v1",
        "type": "string"
      },
      "accepted_config_digest": {
        "description": "Окончательный digest сохранённого activation_preview, явно показанного и принятого человеком. Совпадает с Operation.accepted_config_digest и accepted_configs.digest, не с digest черновика. Выбранная репетиция обязана быть сохранена для того же readiness_check_id и окончательного digest.",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "command": {
        "$ref": "#/components/schemas/CommandMeta"
      },
      "confirm_activate": {
        "const": true,
        "type": "boolean"
      },
      "draft_id": {
        "format": "uuid",
        "type": "string"
      },
      "draft_revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "readiness_check_id": {
        "format": "uuid",
        "type": "string"
      },
      "rehearsal_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "command",
      "draft_id",
      "draft_revision",
      "readiness_check_id",
      "rehearsal_id",
      "accepted_config_digest",
      "acceptance_text_version",
      "confirm_activate"
    ],
    "type": "object"
  },
  "Operation": {
    "additionalProperties": false,
    "properties": {
      "accepted_config_digest": {
        "anyOf": [
          {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Digest принятого полного canonical_config либо null до принятия. То же окончательное значение, которое человек подтвердил в ActivationCommand и которое сохранено в accepted_configs.digest."
      },
      "accepted_config_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "connection_health": {
        "enum": [
          "READY",
          "DEGRADED",
          "REVOKED",
          "UNCHECKED"
        ],
        "type": "string"
      },
      "drain_deadline_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "first_activation_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "name": {
        "maxLength": 120,
        "type": "string"
      },
      "operation_id": {
        "format": "uuid",
        "type": "string"
      },
      "revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "state": {
        "enum": [
          "DRAFT",
          "PREPARED",
          "ACTIVE",
          "DRAINING",
          "PAUSED",
          "ARCHIVED"
        ],
        "type": "string"
      }
    },
    "required": [
      "operation_id",
      "revision",
      "name",
      "state",
      "first_activation_at",
      "accepted_config_id",
      "accepted_config_digest",
      "connection_health",
      "drain_deadline_at"
    ],
    "type": "object"
  },
  "CanonicalAcceptedConfig": {
    "additionalProperties": false,
    "description": "Предлагаемый полный безопасный снимок существующей конфигурации Processing после разрешения псевдонимов. Все поля существенны и обязательны; секреты, private BindingProof, сессии и свободный текст здесь запрещены. Ограничения safe_config_valid и происхождение service_label из каталога сохраняются.",
    "properties": {
      "assignee_id": {
        "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
        "type": "string"
      },
      "destination_connection_id": {
        "format": "uuid",
        "type": "string"
      },
      "destination_workspace_id": {
        "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
        "type": "string"
      },
      "list_id": {
        "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
        "type": "string"
      },
      "mode": {
        "enum": [
          "TEST",
          "LIVE"
        ],
        "type": "string"
      },
      "pack_id": {
        "const": "PAID_ORDER_TASK_V1",
        "type": "string"
      },
      "price_id": {
        "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
        "type": "string"
      },
      "required_context_keys": {
        "items": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "maxItems": 20,
        "type": "array",
        "uniqueItems": true
      },
      "service_label": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "source_connection_id": {
        "format": "uuid",
        "type": "string"
      },
      "title_pattern": {
        "enum": [
          "SERVICE_ORDER"
        ],
        "type": "string"
      }
    },
    "required": [
      "pack_id",
      "source_connection_id",
      "destination_connection_id",
      "destination_workspace_id",
      "price_id",
      "list_id",
      "assignee_id",
      "mode",
      "required_context_keys",
      "title_pattern",
      "service_label"
    ],
    "type": "object"
  },
  "ActivationPreview": {
    "additionalProperties": false,
    "description": "Неизменяемая конфигурация, показанная до принятия. Идентичность и срок задаёт содержащий ReadinessCheck. Не включает и не создаёт accepted_configs или ACTIVE.",
    "properties": {
      "accepted_config_digest": {
        "description": "sha256: + нижний шестнадцатеричный SHA-256 RFC8785 JCS полного canonical_config, без дополнительных полей и альтернативной нормализации.",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "canonical_config": {
        "$ref": "#/components/schemas/CanonicalAcceptedConfig"
      }
    },
    "required": [
      "canonical_config",
      "accepted_config_digest"
    ],
    "type": "object"
  },
  "Operations": {
    "additionalProperties": false,
    "properties": {
      "items": {
        "items": {
          "$ref": "#/components/schemas/Operation"
        },
        "maxItems": 5,
        "type": "array"
      }
    },
    "required": [
      "items"
    ],
    "type": "object"
  },
  "LifecycleCommand": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "PAUSE",
          "PREPARE_RESUME",
          "ACCEPT_RESUME",
          "ARCHIVE"
        ],
        "type": "string"
      },
      "command": {
        "$ref": "#/components/schemas/CommandMeta"
      },
      "held_disposition": {
        "enum": [
          "PROCESS_ELIGIBLE",
          "DISCARD_WITH_GAP"
        ],
        "type": "string"
      },
      "reason": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "resume_snapshot_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "command",
      "action"
    ],
    "type": "object"
  },
  "ResumeSnapshot": {
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "format": "date-time",
        "type": "string"
      },
      "expires_at": {
        "format": "date-time",
        "type": "string"
      },
      "gaps": {
        "items": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 100,
        "type": "array"
      },
      "oldest_received_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "operation_id": {
        "format": "uuid",
        "type": "string"
      },
      "revision": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "serialized_bytes": {
        "maximum": 16777216,
        "minimum": 0,
        "type": "integer"
      },
      "signal_count": {
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "snapshot_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "snapshot_id",
      "operation_id",
      "revision",
      "signal_count",
      "serialized_bytes",
      "oldest_received_at",
      "gaps",
      "created_at",
      "expires_at"
    ],
    "type": "object"
  }
}
