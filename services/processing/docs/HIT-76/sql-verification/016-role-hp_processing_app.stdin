SELECT current_user,rolsuper,rolbypassrls,rolcreatedb,rolcreaterole,rolreplication,pg_has_role(current_user,'hp_processing_owner','MEMBER'),pg_has_role(current_user,'hp_processing_migrator','MEMBER'),pg_has_role(current_user,'hp_processing_purge','MEMBER'),has_schema_privilege(current_user,'hp_processing','CREATE'),(SELECT nspowner=current_user::regrole FROM pg_namespace WHERE nspname='hp_processing') FROM pg_roles WHERE rolname=current_user;