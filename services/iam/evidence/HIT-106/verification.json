  "browser_scenarios": [
    "HTTPS registration requires email-code, then issues one real IAM session",
    "concurrent replay of the completed callback creates no independent sessions",
    "an existing session cannot be replaced without the revocation coordinator",
    "the confirmed user signs in again with a fresh attempt and the same principal",
    "foreign or missing state and browser authority assertions do not create a session",
    "cancelling an attempt also blocks a later genuine IdP callback for that state",
    "a genuine callback after IAM restart fails with the lost one-use attempt",
    "a genuine unverified-email claim from the test IdP cannot create a session"
  ],
  "postgres_integration_examples": [
    "TestIAMSchemaMigrationRepeatOnFreshConnection",
    "TestIAMSchemaTenantRLSReadAndWriteIsolation",
    "TestPostgresIssuerAtomicAndCompatibleLookup",
    "TestPostgresIssuerConcurrentDeduplication",
    "TestPostgresIssuerDisabledAndPendingRevocations",
    "TestPostgresIssuerRollbackOnInsertFailure",
    "TestPostgresIssuerCommitUncertainDoesNotReturnSuccess"
  ],
  "postgres_full_protocol": "postgres/verification.json",
  "security_checks": [
    "Real browser and application-to-Keycloak HTTPS with a generated test CA and distinct loopback hosts; ordinary TLS verification enabled.",
    "Local HTTPS negative suite validates CA, SAN, expiry, redirect refusal and bounded token/JWKS responses.",
    "Adapter tests reject invalid signatures, algorithms, keys, issuer, audience, authorized party, nonce, and ID token time claims.",
    "Application race tests cover atomic first consumption, foreign binding, expiration, and provider failures.",
    "Existing issuer PostgreSQL integrations cover rollback, uncertain COMMIT, pending revocations and read-side compatibility."
  ],
  "teardown": "No browser lab or prior suite containers, networks, volumes or exposed lab listeners remained.",
  "limitations": [
    "Only test Keycloak and test SMTP, test clock and issuance authority, test session lifetimes.",
    "No production OIDC deployment or trust policy, BFF, profile, GET session, CSRF delivery, logout or rotation/revocation coordinator.",
    "Same-email non-linking follows issuer+subject identity projection and the reused unique SQL identity; no browser same-email scenario is attributed."
  ],
