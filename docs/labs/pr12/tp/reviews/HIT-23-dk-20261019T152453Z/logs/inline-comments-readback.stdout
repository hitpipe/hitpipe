[{"id":4315824884,"node_id":"PRRC_kwDOP5gFxc8AAAABAT5C9A","url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824884","pull_request_review_id":5574076457,"diff_hunk":"@@ -0,0 +1,421 @@\n+{\n+  \"0302-pz01-01\": {\n+    \"id\": \"0302-pz01-01\",\n+    \"lab\": \"0302-pz01\",\n+    \"caption\": \"Рисунок 1 — Требование, задача и значимый запрос на слияние\",\n+    \"insert_location\": \"0302 ПР1 §3.2 после описания изменения; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Браузер → https://hitpipe.atlassian.net/browse/HIT-18 → описание; рядом https://github.com/hitpipe/hitpipe/pull/13 → Files changed → requirement-change.md и local contract.\",\n+    \"source_sha\": \"9d7c37151606656e9dc2f2f65876b8bd93b397cd\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Открыть PR #13, сверить head 9d7c37151606656e9dc2f2f65876b8bd93b397cd и base #12. Показать before/after правила equality/freshness, Task key и реальный статус review. Approval/merge сейчас pending.\",\n+    \"must_be_visible\": [\n+      \"HIT-18\",\n+      \"PR #13\",\n+      \"полный head SHA\",\n+      \"существенное уточнение contract\",\n+      \"реальный статус без выдуманного approval\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz01-01.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz01-02\": {\n+    \"id\": \"0302-pz01-02\",\n+    \"lab\": \"0302-pz01\",\n+    \"caption\": \"Рисунок 2 — Автоматические проверки изменения требований\",\n+    \"insert_location\": \"0302 ПР1 §4 после таблицы проверок; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/pull/13 → Checks → pr12-iam; прямой URL https://github.com/hitpipe/hitpipe/actions/runs/39175925989/job/117818455616\",\n+    \"source_sha\": \"9d7c37151606656e9dc2f2f65876b8bd93b397cd\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Раскрыть Verify bootstrap documentation and frozen copies и Report actual implementation state. Это R2 до кода: green source validation, а student module NOT_IMPLEMENTED/NOT_RUN; не подписывать как тест готового IAM.\",\n+    \"must_be_visible\": [\n+      \"R2 head 9d7c3715...\",\n+      \"название job\",\n+      \"source checks SUCCESS\",\n+      \"NOT_IMPLEMENTED на этой исторической версии\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz01-02.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz01-03\": {\n+    \"id\": \"0302-pz01-03\",\n+    \"lab\": \"0302-pz01\",\n+    \"caption\": \"Рисунок 3 — Оппонирование другого проекта и принятое решение\",\n+    \"insert_location\": \"0302 ПР1 §3.3 после честного статуса оппонирования; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"HUMAN_ACTION_PENDING: до реального действия снимок не доказывает результат; запрещено фотографировать незаполненный протокол как PASS.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/blob/efa7d1860f09bf8b28ec239896780257fbfe559a/docs/labs/pr12/dk/human-gates.md → §5; после реального обсуждения открыть URL обсуждения, который человек внесёт в review/peer-protocol.json.\",\n+    \"source_sha\": \"efa7d1860f09bf8b28ec239896780257fbfe559a\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Сейчас НЕ СНИМАТЬ вымышленное обсуждение. Lead получает назначение преподавателя и внешний проект; DK проводит обсуждение, фиксирует actual URL/дату/участников/версии/замечания/решение/изменение. Затем открыть этот реальный URL и показать связанные ID требований. Отсутствующий будущий URL честно не подставлен.\",\n+    \"must_be_visible\": [\n+      \"другой проект и реальные участники\",\n+      \"дата\",\n+      \"рассмотренная версия\",\n+      \"конкретное замечание\",\n+      \"решение/изменение или обоснованный отказ\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz01-03.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz02-01\": {\n+    \"id\": \"0302-pz02-01\",\n+    \"lab\": \"0302-pz02\",\n+    \"caption\": \"Рисунок 1 — Локальный прогон собственных IAM-тестов\",\n+    \"insert_location\": \"0302 ПР2 §4.1 после локальных результатов; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал → отдельный clone, checkout 2cd7c032e8ede98c75181599b440e97657bff197; исходный evidence https://github.com/hitpipe/hitpipe/blob/2cd7c032e8ede98c75181599b440e97657bff197/docs/labs/pr12/dk/evidence/c3-final-check.log (локальный лог на идентичном Go source 5b14ab92d1ca2a68f46fd3bda783b188549fbf5a).\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"git fetch origin 2cd7c032e8ede98c75181599b440e97657bff197; git switch --detach 2cd7c032e8ede98c75181599b440e97657bff197; git rev-parse HEAD; go version; PR12_RACE=1 python3 tools/pr12/workspace.py check iam --require; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\". Capture реальный новый run; не выдавать прошлый log за новый.\",\n+    \"must_be_visible\": [\n+      \"полный SHA\",\n+      \"Go1.27.2\",\n+      \"TestEvaluateIdleBoundary\",\n+      \"TestSameConsumerContractWithBothAdapters\",\n+      \"реальный итог и exit0\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz02-01.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz02-02\": {\n+    \"id\": \"0302-pz02-02\",\n+    \"lab\": \"0302-pz02\",\n+    \"caption\": \"Рисунок 2 — Собственные тесты и mutations в CI\",\n+    \"insert_location\": \"0302 ПР2 §4.1 после CI результата; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/actions/runs/39177171258/job/117822118583 → job pr12-iam → Run actual named tests / race → Compile isolated IAM mutations.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Открыть run 39177171258 для 2cd7c032e8ede98c75181599b440e97657bff197. Показать checkout SHA, собственные test names, итог race и M01–M07 KILLED, final gate. Во вкладке summary доступны artifacts pr12-iam-2cd7c032e8ede98c75181599b440e97657bff197.\",\n+    \"must_be_visible\": [\n+      \"exact head SHA\",\n+      \"pr12-iam\",\n+      \"собственные tests\",\n+      \"все семь compiling mutants\",\n+      \"SUCCESS\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz02-02.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz02-03\": {\n+    \"id\": \"0302-pz02-03\",\n+    \"lab\": \"0302-pz02\",\n+    \"caption\": \"Рисунок 3 — Покрытие IAM и конкретный непроверенный участок\",\n+    \"insert_location\": \"0302 ПР2 §4.2 после анализа покрытия; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал на 2cd7c032e8ede98c75181599b440e97657bff197; файл docs/labs/pr12/dk/evidence/iam-all.cover и test-results.md.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"cd services/iam; go tool cover -func=../../docs/labs/pr12/dk/evidence/iam-all.cover; go tool cover -html=../../docs/labs/pr12/dk/evidence/iam-all.cover -o ../../.pr12-build/iam-coverage.html. Открыть локальный HTML в браузере → cmd/iam-contractcheck/main.go → main entrypoint; рядом test-results.md с решением. Не утверждать branch coverage.\",\n+    \"must_be_visible\": [\n+      \"имя IAM module\",\n+      \"94.5% statements\",\n+      \"core Evaluate/Execute 100% statements\",\n+      \"main entrypoint/конкретный gap\",\n+      \"обоснованное решение\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz02-03.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz02-04\": {\n+    \"id\": \"0302-pz02-04\",\n+    \"lab\": \"0302-pz02\",\n+    \"caption\": \"Рисунок 4 — Компилируемый дефект M01 обнаружен тестами\",\n+    \"insert_location\": \"0302 ПР2 §4.3 после mutation таблицы; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"На 2cd7c032e8ede98c75181599b440e97657bff197 открыть docs/labs/pr12/dk/evidence/mutations-initial/M01.patch, protocol.json и M01-check.log.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"git rev-parse HEAD; cat docs/labs/pr12/dk/evidence/mutations-initial/M01.patch; python3 -m json.tool docs/labs/pr12/dk/evidence/mutations-initial/protocol.json; rg -n -C 2 \\\"TestEvaluateIdleBoundary/equal|FAIL\\\" docs/labs/pr12/dk/evidence/mutations-initial/M01-check.log. Оригинальный experiment source462d553e8373af6047f0950e0a9adfe15e85c83f, temporary branch записана в protocol и уже удалена после восстановления.\",\n+    \"must_be_visible\": [\n+      \"M01 diff >= заменён на >\",\n+      \"build exit0\",\n+      \"та же wrapper command\",\n+      \"failing named assertion\",\n+      \"test exit1\",\n+      \"source/patch digests\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz02-04.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0302-pz02-05\": {\n+    \"id\": \"0302-pz02-05\",\n+    \"lab\": \"0302-pz02\",\n+    \"caption\": \"Рисунок 5 — Успешный прогон после восстановления\",\n+    \"insert_location\": \"0302 ПР2 §4.3 после итогов серии; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал → clean clone 2cd7c032e8ede98c75181599b440e97657bff197; исходный final-clean.log в mutations-M07-retest.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"git status --short; git rev-parse HEAD; python3 tools/pr12/workspace.py check iam --require; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\"; python3 -m json.tool docs/labs/pr12/dk/evidence/mutations-M07-retest/protocol.json. Показать restored=true и final_clean.exit_code0. Не применять patch к сдаваемой ветке.\",\n+    \"must_be_visible\": [\n+      \"clean source\",\n+      \"полный SHA\",\n+      \"реальные named tests PASS\",\n+      \"exit0\",\n+      \"restored hash и clean flag\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0302-pz02-05.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-01\": {\n+    \"id\": \"0104-pz01-01\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 1 — Собственная часть исполняемого каркаса\",\n+    \"insert_location\": \"0104 ПР1 §3.1 после маршрута PR; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/pull/14 → Files changed → services/iam/cmd/iam-contractcheck/main.go; current module https://github.com/hitpipe/hitpipe/tree/2cd7c032e8ede98c75181599b440e97657bff197/services/iam\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Показать C1 PR #14, scope собственного module и actual current entrypoint. Через вкладку Commits сверить C1 0ead65c2a7bd767841659c0f26f66edd7d763cfb; позже C2 consumer wiring существует на 2cd7c032e8ede98c75181599b440e97657bff197.\",\n+    \"must_be_visible\": [\n+      \"Task HIT-19\",\n+      \"отдельный PR\",\n+      \"свой entrypoint\",\n+      \"реальный code\",\n+      \"состояние review pending\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-01.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-02\": {\n+    \"id\": \"0104-pz01-02\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 2 — Подготовка одного компонента dev/release\",\n+    \"insert_location\": \"0104 ПР1 §3.3 после сравнения режимов; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал → отдельный clone 2cd7c032e8ede98c75181599b440e97657bff197, root.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"git rev-parse HEAD; go version; python3 tools/pr12/workspace.py build iam --mode dev --require; python3 tools/pr12/workspace.py build iam --mode release --require; .pr12-build/iam/dev/iam-contractcheck --version; .pr12-build/iam/release/iam-contractcheck --version; file .pr12-build/iam/dev/iam-contractcheck .pr12-build/iam/release/iam-contractcheck. Зафиксировать actual размеры своего нового build отдельно от сохранённого observation.\",\n+    \"must_be_visible\": [\n+      \"тот же SHA/input\",\n+      \"-N -l и -trimpath\",\n+      \"оба binary paths\",\n+      \"mode/dirty metadata\",\n+      \"ELF тип\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-02.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-03\": {\n+    \"id\": \"0104-pz01-03\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 3 — Поставка запущена вне исходников\",\n+    \"insert_location\": \"0104 ПР1 §3.3 после outside-checkout результата; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал root clean clone 2cd7c032e8ede98c75181599b440e97657bff197.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"git rev-parse HEAD; python3 tools/pr12/workspace.py smoke iam --require; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\". В журнале показать pr12-outside-checkout temporary path, --version, fixture и PASS обоих режимов. Wrapper реально копирует binary+fixtures, не запускает go run из checkout.\",\n+    \"must_be_visible\": [\n+      \"outside-checkout path\",\n+      \"copied executable\",\n+      \"версия\",\n+      \"positive input\",\n+      \"оба режима PASS\",\n+      \"exit0\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-03.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-04\": {\n+    \"id\": \"0104-pz01-04\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 4 — Штатный диагностический запуск\",\n+    \"insert_location\": \"0104 ПР1 §4.1 после таблицы component checks; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал root clean clone 2cd7c032e8ede98c75181599b440e97657bff197 после release build.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \".pr12-build/iam/release/iam-contractcheck --version; .pr12-build/iam/release/iam-contractcheck --fixture services/iam/testdata/valid.json --format json; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\".\",\n+    \"must_be_visible\": [\n+      \"source SHA\",\n+      \"synthetic fixture path\",\n+      \"event=start/end\",\n+      \"state valid/reason session_valid\",\n+      \"exit0\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-04.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-05\": {\n+    \"id\": \"0104-pz01-05\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 5 — Неверная конфигурация и безопасная диагностика\",\n+    \"insert_location\": \"0104 ПР1 §4.1 после ошибочного случая; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал того же release build 2cd7c032e8ede98c75181599b440e97657bff197.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \".pr12-build/iam/release/iam-contractcheck --fixture services/iam/testdata/malformed.json --format json; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\"; .pr12-build/iam/release/iam-contractcheck --fixture services/iam/testdata/valid.json --format invalid; printf \\\"exit=%s\\\\n\\\" \\\"$?\\\". Без set -e, иначе shell остановится до вывода exit.\",\n+    \"must_be_visible\": [\n+      \"оба неверных ввода\",\n+      \"invalid_config\",\n+      \"exit2\",\n+      \"нет содержимого fixture/секретов\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-05.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-06\": {\n+    \"id\": \"0104-pz01-06\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 6 — Реальное независимое воспроизведение чужой части\",\n+    \"insert_location\": \"0104 ПР1 §4.2 после статуса peer gate; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"HUMAN_ACTION_PENDING: до реального действия снимок не доказывает результат; запрещено фотографировать незаполненный протокол как PASS.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/pull/10 → TP candidate adfbfc33bf20cb0b0641e49e48c0502d2f5d108d; H1 instructions https://github.com/hitpipe/hitpipe/blob/efa7d1860f09bf8b28ec239896780257fbfe559a/docs/labs/pr12/dk/human-gates.md → §4.\",\n+    \"source_sha\": \"adfbfc33bf20cb0b0641e49e48c0502d2f5d108d\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Дмитрий лично клонирует TP exact candidate в чистую среду и выполняет validate/check processing/smoke processing по H1. После реального выполнения заполнить reviewer/date/env/fullSHA/argv/exit/remarks/retest в review/peer-protocol.json и показать свой terminal+protocol. Агент этого student action не выполнял. Для обратной стороны Тимофей Патрушев проверяет DK в отдельном чистом checkout текущего head PR #19 и фиксирует actual SHA по review/TIMOFEY_REVIEW_GUIDE_RU.md.\",\n+    \"must_be_visible\": [\n+      \"кто реально проверял\",\n+      \"чужой Processing component\",\n+      \"полный TP SHA\",\n+      \"чистая среда\",\n+      \"actual commands/result/remarks/retest\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-06.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz01-07\": {\n+    \"id\": \"0104-pz01-07\",\n+    \"lab\": \"0104-pz01\",\n+    \"caption\": \"Рисунок 7 — Та же команда CI отвергает нарушенное условие\",\n+    \"insert_location\": \"0104 ПР1 §4.3 после отрицательного gate; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Сохранённые M01-build.log, M01-check.log, protocol.json и final-clean.log на 2cd7c032e8ede98c75181599b440e97657bff197.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Открыть .github/workflows/pr12-dk.yml и protocol.json рядом. Показать одинаковую команду python3 tools/pr12/workspace.py check iam --require, build0, нарушенный idle equality→test1, затем восстановленный0. Это настоящий локальный negative gate с CI command, не поддельный красный CI run.\",\n+    \"must_be_visible\": [\n+      \"одна и та же command\",\n+      \"компилируемый M01\",\n+      \"незелёный assertion\",\n+      \"восстановленный PASS\",\n+      \"exact source\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz01-07.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz02-01\": {\n+    \"id\": \"0104-pz02-01\",\n+    \"lab\": \"0104-pz02\",\n+    \"caption\": \"Рисунок 1 — Публичный контракт и существенная реализация\",\n+    \"insert_location\": \"0104 ПР2 §3.2 после реализации; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"https://github.com/hitpipe/hitpipe/blob/2cd7c032e8ede98c75181599b440e97657bff197/services/iam/internal/domain/sessionpolicy/policy.go и /services/iam/internal/application/authenticatesession/service.go.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",\n+    \"command\": \"Открыть Evaluate и Service.Execute, затем CLI call-site. Показать pure values, idle/absolute equality, ports и реальное подключение. Рядом PR14/15 с отдельными Task keys.\",\n+    \"must_be_visible\": [\n+      \"Evaluate\",\n+      \"Execute\",\n+      \"портовая граница\",\n+      \"реальная ветвящаяся логика\",\n+      \"вызов consumer\"\n+    ],\n+    \"target_file\": \"docs/labs/pr12/dk/evidence/screenshots/0104-pz02-01.png\",\n+    \"redaction\": \"Скрыть cookies, tokens, SSH/private keys, лишние email/персональные вкладки. Синтетические fixture и безопасные reason codes оставить. Не обрезать команду, SHA, имя теста/участника, итог и exit. Если не помещается — последовательные кадры с тем же номером и суффиксами a,b; лог не редактировать.\"\n+  },\n+  \"0104-pz02-02\": {\n+    \"id\": \"0104-pz02-02\",\n+    \"lab\": \"0104-pz02\",\n+    \"caption\": \"Рисунок 2 — Документация модуля по стандарту Go\",\n+    \"insert_location\": \"0104 ПР2 §3.1 после контракта; заменить только выделенное место этой фигуры реальным снимком, подпись сохранить.\",\n+    \"state\": \"IMAGE_PENDING: фактическое текстовое evidence уже существует; снимок делает человек.\",\n+    \"navigation\": \"Терминал → services/iam на 2cd7c032e8ede98c75181599b440e97657bff197; module-contract.md.\",\n+    \"source_sha\": \"2cd7c032e8ede98c75181599b440e97657bff197\",\n+    \"cwd\": \"Отдельный чистый clone hitpipe/hitpipe, корень репозитория. Не переключать и не сбрасывать рабочую копию с незакоммиченными изменениями.\",","path":"docs/labs/pr12/dk/reports/figures.json","position":330,"original_position":330,"commit_id":"f67dd3faefb6a9e61dc1b3dbcbdfe158c5744fcd","user":{"login":"Tim1hik","id":148378645,"node_id":"U_kgDOCNgUFQ","avatar_url":"https://avatars.githubusercontent.com/u/148378645?v=4","gravatar_id":"","url":"https://api.github.com/users/Tim1hik","html_url":"https://github.com/Tim1hik","followers_url":"https://api.github.com/users/Tim1hik/followers","following_url":"https://api.github.com/users/Tim1hik/following{/other_user}","gists_url":"https://api.github.com/users/Tim1hik/gists{/gist_id}","starred_url":"https://api.github.com/users/Tim1hik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Tim1hik/subscriptions","organizations_url":"https://api.github.com/users/Tim1hik/orgs","repos_url":"https://api.github.com/users/Tim1hik/repos","events_url":"https://api.github.com/users/Tim1hik/events{/privacy}","received_events_url":"https://api.github.com/users/Tim1hik/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[P2] DK-REV-001 — согласуйте cwd и Go-команды\n\nCodex по делегации Тимофея Патрушева; это агентное ревью. Здесь и у 0104-pz02-05 (строка389) cwd задан как root, но `go doc ./internal/domain/sessionpolicy` и `go test ./internal/adapters/fixtures/sessionlookup ...` из root дают exit1: directory not found. Navigation одновременно указывает services/iam. Задайте один однозначный cwd services/iam либо root + `go -C services/iam ...`, синхронизируйте INSTRUCTIONS и DOCX; буквально повторите команды и package verifier. [Repro и логи](https://github.com/hitpipe/hitpipe/blob/6e1ac5bd36fce07d979b757cbf957393ed83e3f3/docs/labs/pr12/tp/reviews/HIT-23-dk-20261019T152453Z/FINDINGS.md#dk-rev-001-p2-согласовать-cwd-и-команды-двух-инструкций-мдк0104-пр2).","created_at":"2026-10-19T15:42:12Z","updated_at":"2026-10-19T15:42:12Z","html_url":"https://github.com/hitpipe/hitpipe/pull/19#discussion_r4315824884","pull_request_url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/19","author_association":"MEMBER","_links":{"self":{"href":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824884"},"html":{"href":"https://github.com/hitpipe/hitpipe/pull/19#discussion_r4315824884"},"pull_request":{"href":"https://api.github.com/repos/hitpipe/hitpipe/pulls/19"}},"original_commit_id":"f67dd3faefb6a9e61dc1b3dbcbdfe158c5744fcd","reactions":{"url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824884/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"id":4315824897,"node_id":"PRRC_kwDOP5gFxc8AAAABAT5DAQ","url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824897","pull_request_review_id":5574076457,"diff_hunk":"@@ -0,0 +1,163 @@\n+#!/usr/bin/env python3\n+\"\"\"Build DK's four reports from edited Markdown using the pinned DOCX forms.\n+\n+Requires python-docx==1.2.0. No screenshot capture, image generation, renderer or\n+external application is invoked. Human evidence fields remain explicitly pending.\n+\"\"\"\n+import hashlib\n+import json\n+from pathlib import Path\n+import re\n+from zipfile import ZipFile\n+import xml.etree.ElementTree as ET\n+\n+import docx\n+from docx import Document\n+from docx.oxml import OxmlElement\n+from docx.oxml.ns import qn\n+from docx.shared import Pt\n+from docx.enum.text import WD_ALIGN_PARAGRAPH\n+\n+HERE=Path(__file__).resolve().parent\n+ROOT=HERE.parents[4]\n+TEMPLATES=ROOT/'docs/labs/pr12/templates'\n+FIGURES=json.loads((HERE/'figures.json').read_text())\n+\n+def inline(paragraph,text):\n+    pattern=r'(\\[[^\\]]+\\]\\(https?://[^)]+\\)|`[^`]+`|\\*\\*[^*]+\\*\\*)'\n+    for part in re.split(pattern,text):\n+        link=re.fullmatch(r'\\[([^\\]]+)\\]\\((https?://[^)]+)\\)',part)\n+        if link:\n+            item=OxmlElement('w:hyperlink')\n+            rid=paragraph.part.relate_to(link[2],'http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink',is_external=True)\n+            item.set(qn('r:id'),rid)\n+            run=OxmlElement('w:r');props=OxmlElement('w:rPr');color=OxmlElement('w:color');color.set(qn('w:val'),'0563C1');props.append(color);run.append(props)\n+            t=OxmlElement('w:t');t.text=link[1];run.append(t);item.append(run);paragraph._p.append(item)\n+        else:\n+            run=paragraph.add_run(part[2:-2] if part.startswith('**') else part[1:-1] if part.startswith('`') else part)\n+            if part.startswith('**'):run.bold=True\n+            if part.startswith('`'):run.font.name='Consolas';run.font.size=Pt(10)\n+\n+def paragraph(document,text,style=None):\n+    p=document.add_paragraph(style=style);inline(p,text);return p\n+\n+def render_figure(document,identity):\n+    f=FIGURES[identity]\n+    document.add_paragraph(f['caption'],style='Caption')\n+    p=paragraph(document,'[МЕСТО ДЛЯ СКРИНШОТА: '+identity+']')\n+    for run in p.runs:run.bold=True\n+    for key,label in [('insert_location','Куда вставить'),('state','Статус'),('navigation','Навигация'),('source_sha','Точная исходная версия'),('cwd','Рабочий каталог'),('command','Команды / действия'),('must_be_visible','Что должно быть видно'),('target_file','Имя файла'),('redaction','Что скрыть')]:\n+        value=f[key]\n+        if isinstance(value,list):value='; '.join(value)\n+        paragraph(document,label+': '+value)\n+\n+def render_markdown(document,text):\n+    lines=text.splitlines();i=0;code=False\n+    while i<len(lines):\n+        line=lines[i].strip();i+=1\n+        if line.startswith('```'):code=not code;continue\n+        if code:\n+            p=document.add_paragraph();run=p.add_run(lines[i-1]);run.font.name='Consolas';run.font.size=Pt(9);continue\n+        if not line:continue\n+        marker=re.fullmatch(r'<!-- FIGURE:([a-z0-9-]+) -->',line)\n+        if marker:render_figure(document,marker[1]);continue\n+        heading=re.match(r'^(#{1,4}) (.*)',line)\n+        if heading:\n+            if len(heading[1])==1:continue  # the preserved teacher title page owns the title\n+            document.add_heading(heading[2],level=min(3,len(heading[1])-1));continue\n+        if line.startswith('|'):\n+            rows=[]\n+            while True:\n+                cells=[c.strip() for c in line.strip('|').split('|')]\n+                if not all(re.fullmatch(r':?-+:?',c) for c in cells):rows.append(cells)\n+                if i>=len(lines) or not lines[i].strip().startswith('|'):break\n+                line=lines[i].strip();i+=1\n+            table=document.add_table(rows=0,cols=max(map(len,rows)))\n+            try:table.style='Table Grid'\n+            except KeyError:pass\n+            for n,cells in enumerate(rows):\n+                row=table.add_row()","path":"docs/labs/pr12/dk/reports/build_reports.py","position":79,"original_position":79,"commit_id":"f67dd3faefb6a9e61dc1b3dbcbdfe158c5744fcd","user":{"login":"Tim1hik","id":148378645,"node_id":"U_kgDOCNgUFQ","avatar_url":"https://avatars.githubusercontent.com/u/148378645?v=4","gravatar_id":"","url":"https://api.github.com/users/Tim1hik","html_url":"https://github.com/Tim1hik","followers_url":"https://api.github.com/users/Tim1hik/followers","following_url":"https://api.github.com/users/Tim1hik/following{/other_user}","gists_url":"https://api.github.com/users/Tim1hik/gists{/gist_id}","starred_url":"https://api.github.com/users/Tim1hik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Tim1hik/subscriptions","organizations_url":"https://api.github.com/users/Tim1hik/orgs","repos_url":"https://api.github.com/users/Tim1hik/repos","events_url":"https://api.github.com/users/Tim1hik/events{/privacy}","received_events_url":"https://api.github.com/users/Tim1hik/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[P2] DK-REV-002 — сохраняйте строки и контекст продолжений таблиц\n\nCodex по делегации Тимофея Патрушева; это агентное ревью. Строки создаются без запрета разрыва и повторяемой шапки. В реальном рендере всех4форм от строки «Время работы» отрывается слово JSON на следующую страницу (0104:3→4;0302:4→5); риск-таблица0302-ПР2 страницы8–10 продолжается без заголовков. Добавьте cantSplit для коротких строк, tblHeader и корректные ширины/при необходимости альбомную секцию. Сохраните все записи и повторите полный рендер/проверку таблиц. [PDF и подробности](https://github.com/hitpipe/hitpipe/blob/6e1ac5bd36fce07d979b757cbf957393ed83e3f3/docs/labs/pr12/tp/reviews/HIT-23-dk-20261019T152453Z/FINDINGS.md).","created_at":"2026-10-19T15:42:12Z","updated_at":"2026-10-19T15:42:12Z","html_url":"https://github.com/hitpipe/hitpipe/pull/19#discussion_r4315824897","pull_request_url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/19","author_association":"MEMBER","_links":{"self":{"href":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824897"},"html":{"href":"https://github.com/hitpipe/hitpipe/pull/19#discussion_r4315824897"},"pull_request":{"href":"https://api.github.com/repos/hitpipe/hitpipe/pulls/19"}},"original_commit_id":"f67dd3faefb6a9e61dc1b3dbcbdfe158c5744fcd","reactions":{"url":"https://api.github.com/repos/hitpipe/hitpipe/pulls/comments/4315824897/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}}]