diff --git a/.github/workflows/pr12-dk.yml b/.github/workflows/pr12-dk.yml
index 84cbd74..7703266 100644
--- a/.github/workflows/pr12-dk.yml
+++ b/.github/workflows/pr12-dk.yml
@@ -26,6 +26,9 @@ jobs:
