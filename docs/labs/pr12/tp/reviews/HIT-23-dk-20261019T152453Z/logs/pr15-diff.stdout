+Task HIT-18, после R1 commit `0661a3ea64bd9f5243a9a7f5b3e1195c31eef152`. Сначала спецификация PR #13, затем реализация HIT-19/20. Это внутренняя проекция IAM, не изменение OAS/SQL. С C1 канонический файл находится здесь; прежний `docs/labs/pr12/dk/module-contract.md` — указатель.
 
 ## Ответственность и публичная операция
 
@@ -70,7 +70,9 @@ Constructor отвергает nil и typed-nil реализации. Execute т
 
 Для known session и clock требуемые поля не принимают null/отсутствие. В unknown projection timestamps могут отсутствовать; присутствующие timestamp всё равно должны разбираться. Boolean presence отличается от false. Timestamp — RFC3339Nano с offset. Строгий decoder отклоняет duplicate/extra keys, unknown version, неверные типы, trailing document, malformed JSON и input >64 KiB; глубина JSON ограничена 16. Значения из ошибок parser не печатаются.
 
-`iam-contractcheck --fixture PATH --format text|json`, `--version`. Путь и формат влияют на выполнение; отсутствующий/неверный путь, формат и broken fixture дают exit 2. Структурно корректное решение policy, включая безопасный denied, даёт exit 0: отказ сессии — ожидаемый бизнес-результат, не неисправность CLI. После C2 `--lookup file|fixed` меняет adapter в одной точке сборки, без правки Execute. `--clock fixture|system` выбирает фиксированное синтетическое время либо host clock adapter; последний остаётся unavailable без реального clock-health probe, а не объявляет `time.Now()` доказанно доверенным.
+`iam-contractcheck --fixture PATH --format text|json`, `--version`. Путь и формат влияют на выполнение; отсутствующий/неверный путь, формат и broken fixture дают exit 2. Структурно корректное решение policy, включая безопасный denied, даёт exit 0: отказ сессии — ожидаемый бизнес-результат, не неисправность CLI. Application unavailable даёт exit 3. С C2 `--lookup file|fixed` меняет adapter в одной точке сборки, без правки Execute. `--clock fixture|system` выбирает фиксированное синтетическое время либо host clock adapter; последний остаётся unavailable без реального clock-health probe, а не объявляет `time.Now()` доказанно доверенным.
+
+File повторно читает один synthetic fixture на каждый Lookup; Fixed хранит неизменяемую копию. Оба игнорируют reference и потому НЕ являются multi-session authority. Fixture clock — construction-time observation из исходного файла; она не доказывает свежесть изменённого authority. Адаптеры возвращают value, а не изменяемые ссылки. System.HealthProbe получает наблюдённый instant и должен реально установить его доверенность в среде deployment; тестовая true-функция только unit-test double. CLI такую функцию не устанавливает.
 
 На stderr только фиксированные коды старта/исхода; stdout — state/reason либо build metadata. Профили, reference, fixture body и canary не выводятся. Повторный запуск не меняет исходные данные, не создаёт sessions, не выполняет внешних команд.
 
diff --git a/services/iam/internal/adapters/clock/system/clock.go b/services/iam/internal/adapters/clock/system/clock.go
new file mode 100644
index 0000000..9f5bed4
--- /dev/null
+++ b/services/iam/internal/adapters/clock/system/clock.go
@@ -0,0 +1,33 @@
+// Package system wraps the host clock without inventing an attestation of it.
+package system
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/hitpipe/hitpipe/services/iam/internal/application/authenticatesession"
+	"github.com/hitpipe/hitpipe/services/iam/internal/domain/sessionpolicy"
+)
+
+// HealthProbe must establish trust for the supplied host observation in the
+// deployment environment. No such real probe is shipped by this offline slice.
+type HealthProbe func(context.Context, time.Time) bool
+
+type Clock struct{ probe HealthProbe }
+
+// New can be given nil, which deliberately yields unavailable, never Trusted.
+func New(probe HealthProbe) *Clock { return &Clock{probe: probe} }
+
+func (c *Clock) Now(ctx context.Context) (sessionpolicy.Observation, error) {
+	if c == nil || c.probe == nil || ctx == nil || ctx.Err() != nil {
+		return sessionpolicy.Observation{}, errors.New("clock_unavailable")
+	}
+	now := time.Now().UTC()
+	if !c.probe(ctx, now) || ctx.Err() != nil {
+		return sessionpolicy.Observation{}, errors.New("clock_unavailable")
+	}
+	return sessionpolicy.Observation{At: now, Trusted: true}, nil
+}
+
+var _ authenticatesession.Clock = (*Clock)(nil)
diff --git a/services/iam/internal/adapters/clock/system/clock_test.go b/services/iam/internal/adapters/clock/system/clock_test.go
new file mode 100644
index 0000000..abe5ae7
--- /dev/null
+++ b/services/iam/internal/adapters/clock/system/clock_test.go
@@ -0,0 +1,35 @@
+package system_test
+
+import (
+	"context"
+	"github.com/hitpipe/hitpipe/services/iam/internal/adapters/clock/system"
+	"testing"
+	"time"
+)
+
+func TestSystemClockRequiresAttestation(t *testing.T) {
+	var nilClock *system.Clock
+	for _, clock := range []*system.Clock{nilClock, system.New(nil), system.New(func(context.Context, time.Time) bool { return false })} {
+		if o, e := clock.Now(context.Background()); e == nil || o.Trusted {
+			t.Fatal("clock trusted without attestation")
+		}
+	}
+	// A synthetic probe is an adapter unit test, not evidence of host health.
+	clock := system.New(func(_ context.Context, at time.Time) bool { return !at.IsZero() })
+	if o, e := clock.Now(context.Background()); e != nil || !o.Usable() {
+		t.Fatal("synthetic attestation not used")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if o, e := clock.Now(ctx); e == nil || o.Trusted {
+		t.Fatal("cancelled time trusted")
+	}
+	if o, e := clock.Now(nil); e == nil || o.Trusted {
+		t.Fatal("nil context trusted")
+	}
+	ctx, cancel = context.WithCancel(context.Background())
+	clock = system.New(func(context.Context, time.Time) bool { cancel(); return true })
+	if o, e := clock.Now(ctx); e == nil || o.Trusted {
+		t.Fatal("probe cancellation ignored")
+	}
+}
diff --git a/services/iam/internal/adapters/fixtures/sessionlookup/adapters.go b/services/iam/internal/adapters/fixtures/sessionlookup/adapters.go
new file mode 100644
index 0000000..ecce0f7
--- /dev/null
+++ b/services/iam/internal/adapters/fixtures/sessionlookup/adapters.go
@@ -0,0 +1,77 @@
+package sessionlookup
+
+import (
+	"context"
+	"errors"
+	"os"
+
+	"github.com/hitpipe/hitpipe/services/iam/internal/application/authenticatesession"
+	"github.com/hitpipe/hitpipe/services/iam/internal/domain/sessionpolicy"
+)
+
+var errLookup = errors.New("lookup_unavailable")
+
+// File reads and strictly decodes its fixture on each Lookup. The reference is
+// a synthetic routing key; no production identifier-to-file mapping is implied.
+type File struct{ path string }
+
+// NewFile binds one synthetic fixture, with no filesystem side effects.
+func NewFile(path string) (*File, error) {
+	if path == "" {
+		return nil, errLookup
+	}
+	return &File{path: path}, nil
+}
+
+func (f *File) Lookup(ctx context.Context, _ string) (sessionpolicy.Snapshot, error) {
+	if f == nil || ctx == nil || ctx.Err() != nil {
+		return sessionpolicy.Snapshot{}, errLookup
+	}
+	file, err := os.Open(f.path)
+	if err != nil {
+		return sessionpolicy.Snapshot{}, errLookup
+	}
+	defer file.Close()
+	snapshot, _, err := Decode(file)
+	if err != nil || ctx.Err() != nil {
+		return sessionpolicy.Snapshot{}, errLookup
+	}
+	return snapshot, nil
+}
+
+// Fixed is an immutable in-memory synthetic double. Lookup returns values, never
+// caller-owned pointers. Unlike File it performs no IO or freshness check.
+type Fixed struct {
+	snapshot sessionpolicy.Snapshot
+	failed   bool
+}
+
+func NewFixed(snapshot sessionpolicy.Snapshot, failed bool) *Fixed {
+	return &Fixed{snapshot: snapshot, failed: failed}
+}
+
+func (f *Fixed) Lookup(ctx context.Context, _ string) (sessionpolicy.Snapshot, error) {
+	if f == nil || ctx == nil || ctx.Err() != nil || f.failed {
+		return sessionpolicy.Snapshot{}, errLookup
+	}
+	return f.snapshot, nil
+}
+
+// FixedClock returns the immutable synthetic observation read from a fixture.
+// It makes deterministic tests possible; it does not attest host clock health.
+type FixedClock struct{ observation sessionpolicy.Observation }
+
+func NewFixedClock(observation sessionpolicy.Observation) *FixedClock {
+	return &FixedClock{observation: observation}
+}
+
+func (f *FixedClock) Now(ctx context.Context) (sessionpolicy.Observation, error) {
+	if f == nil || ctx == nil || ctx.Err() != nil {
+		return sessionpolicy.Observation{}, errors.New("clock_unavailable")
+	}
+	return f.observation, nil
+}
+
+var _ authenticatesession.SessionLookup = (*File)(nil)
+var _ authenticatesession.SessionLookup = (*Fixed)(nil)
+var _ authenticatesession.Clock = (*FixedClock)(nil)
diff --git a/services/iam/internal/adapters/fixtures/sessionlookup/adapters_test.go b/services/iam/internal/adapters/fixtures/sessionlookup/adapters_test.go
new file mode 100644
index 0000000..7193c20
--- /dev/null
+++ b/services/iam/internal/adapters/fixtures/sessionlookup/adapters_test.go
@@ -0,0 +1,162 @@
+package sessionlookup_test
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/hitpipe/hitpipe/services/iam/internal/adapters/fixtures/sessionlookup"
+	"github.com/hitpipe/hitpipe/services/iam/internal/application/authenticatesession"
+	"github.com/hitpipe/hitpipe/services/iam/internal/domain/sessionpolicy"
+)
+
+func encoded(t *testing.T, s sessionpolicy.Snapshot, o sessionpolicy.Observation) []byte {
+	t.Helper()
+	data, err := json.Marshal(map[string]any{"version": 1, "session": map[string]any{"found": s.Found, "revoked": s.Revoked, "created_at": s.CreatedAt.Format(time.RFC3339Nano), "expires_at": s.ExpiresAt.Format(time.RFC3339Nano), "idle_expires_at": s.IdleExpiresAt.Format(time.RFC3339Nano)}, "clock": map[string]any{"trusted": o.Trusted, "now": o.At.Format(time.RFC3339Nano)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestSameConsumerContractWithBothAdapters(t *testing.T) {
+	created := time.Date(2026, 10, 18, 0, 0, 0, 0, time.UTC)
+	snapshot := sessionpolicy.Snapshot{Found: true, CreatedAt: created, ExpiresAt: created.Add(24 * time.Hour), IdleExpiresAt: created.Add(8 * time.Hour)}
+	for _, kind := range []string{"file", "fixed"} {
+		for _, scenario := range []string{"normal", "idle equal", "unknown", "revoked", "error"} {
+			t.Run(kind+"/"+scenario, func(t *testing.T) {
+				s := snapshot
+				o := sessionpolicy.Observation{At: created.Add(7 * time.Hour), Trusted: true}
+				want := "session_valid"
+				switch scenario {
+				case "idle equal":
+					o.At = s.IdleExpiresAt
+					want = "idle_expired"
+				case "unknown":
+					s.Found = false
+					want = "unknown_session"
+				case "revoked":
+					s.Revoked = true
+					want = "revoked_session"
+				case "error":
+					want = "lookup_unavailable"
+				}
+				var lookup authenticatesession.SessionLookup
+				if kind == "file" {
+					path := filepath.Join(t.TempDir(), "fixture.json")
+					if err := os.WriteFile(path, encoded(t, s, o), 0600); err != nil {
+						t.Fatal(err)
+					}
+					file, err := sessionlookup.NewFile(path)
+					if err != nil {
+						t.Fatal(err)
+					}
+					lookup = file
+					if scenario == "error" {
+						if err := os.Remove(path); err != nil {
+							t.Fatal(err)
+						}
+					}
+				} else {
+					lookup = sessionlookup.NewFixed(s, scenario == "error")
+				}
+				// Only the injected adapter varies; Service and its operation are identical.
+				consumer, err := authenticatesession.New(lookup, sessionlookup.NewFixedClock(o))
+				if err != nil {
+					t.Fatal(err)
+				}
+				result := consumer.Execute(context.Background(), "synthetic")
+				if result.Reason != want || result.IsValid() != (scenario == "normal") {
+					t.Fatal(result)
+				}
+				if scenario == "error" && result.State != "unavailable" {
+					t.Fatal(result)
+				}
+			})
+		}
+	}
+}
+
+func TestFileReloadFixedOwnershipAndConcurrency(t *testing.T) {
+	created := time.Date(2026, 10, 18, 0, 0, 0, 0, time.UTC)
+	s := sessionpolicy.Snapshot{Found: true, CreatedAt: created, ExpiresAt: created.Add(24 * time.Hour), IdleExpiresAt: created.Add(8 * time.Hour)}
+	o := sessionpolicy.Observation{At: created.Add(time.Hour), Trusted: true}
+	path := filepath.Join(t.TempDir(), "fixture.json")
+	if err := os.WriteFile(path, encoded(t, s, o), 0600); err != nil {
+		t.Fatal(err)
+	}
+	f, _ := sessionlookup.NewFile(path)
+	fixed := sessionlookup.NewFixed(s, false)
+	s.Revoked = true
+	if err := os.WriteFile(path, encoded(t, s, o), 0600); err != nil {
+		t.Fatal(err)
+	}
+	got, err := f.Lookup(context.Background(), "a")
+	if err != nil || !got.Revoked {
+		t.Fatal("File cached stale snapshot")
+	}
+	got, err = fixed.Lookup(context.Background(), "a")
+	if err != nil || got.Revoked {
+		t.Fatal("Fixed aliased caller data")
+	}
+	got.Revoked = true
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			v, e := fixed.Lookup(context.Background(), "a")
+			if e != nil || v.Revoked {
+				t.Error("mutable snapshot escaped")
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestAdapterFailureAndBoundaryInputs(t *testing.T) {
+	if _, err := sessionlookup.NewFile(""); err == nil {
+		t.Fatal("empty file accepted")
+	}
+	var f *sessionlookup.File
+	var fixed *sessionlookup.Fixed
+	var clock *sessionlookup.FixedClock
+	if _, e := f.Lookup(context.Background(), "a"); e == nil {
+		t.Fatal("nil file")
+	}
+	if _, e := fixed.Lookup(context.Background(), "a"); e == nil {
+		t.Fatal("nil fixed")
+	}
+	if _, e := clock.Now(context.Background()); e == nil {
+		t.Fatal("nil clock")
+	}
+	for _, data := range []string{"null", "{", `{"version":1,"session":{},"clock":{}}`, strings.Repeat("[", 18) + strings.Repeat("]", 18)} {
+		if _, _, e := sessionlookup.Decode(strings.NewReader(data)); e == nil {
+			t.Fatal("bad fixture accepted")
+		}
+	}
+	if _, _, e := sessionlookup.Decode(nil); e == nil {
+		t.Fatal("nil reader")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := sessionlookup.NewFixed(sessionpolicy.Snapshot{}, false).Lookup(ctx, "a"); e == nil {
+		t.Fatal("cancel ignored")
+	}
+	if _, e := sessionlookup.NewFixedClock(sessionpolicy.Observation{}).Now(ctx); e == nil {
+		t.Fatal("cancel clock ignored")
+	}
+	path := filepath.Join(t.TempDir(), "bad.json")
+	if err := os.WriteFile(path, []byte("{"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	broken, _ := sessionlookup.NewFile(path)
+	if _, e := broken.Lookup(context.Background(), "a"); e == nil || strings.Contains(e.Error(), path) {
+		t.Fatal("bad file allowed or path leaked")
+	}
+}
