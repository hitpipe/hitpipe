    "barrier": {
      "port": 9443,
      "authentication": "IAM-only issuer/SAN; same runtime process/gates; no business/health routes"
    },
    "health": {
      "port": 9444,
      "authentication": "OPS-only issuer/SAN; no business/control routes"
    },
    "postgresql": {
      "port": 5432,
      "authentication": "private TLS+per-service DB role only"
    }
  },
  "content": {
    "durability": "file fsync,atomic rename,directory fsync before SQL ref commit",
    "backup": false,
    "historical_snapshots": false,
    "expiry": "class/origin/expiry durable sidecar independent of SQL; read-time deny and hard-deadline purge"
  },
  "backup": {
    "kind": "selective logical minimum safety/config/deletion metadata only",
    "maximum_age_days": 21,
    "exclude": [
      "content files",
      "raw webhook",
      "full wire outbox bodies",
      "AI transcript",
      "provider credential files",
      "host-volume snapshots",
      "physical PG/WAL archive"
    ]
  },
  "controlled_rpo0_contour": [
    "runtime kill/restart",
    "OS/DB restart with intact correctly flushed PG+content volumes",
    "temporary state unavailability with same durable volumes"
  ],
  "outside_rpo0_contour": [
    "all-current-volume loss",
    "unrecoverable storage corruption",
    "dishonest flush controller",
    "site loss"
  ],
  "qualification": "No resource value grants capacity/live readiness. Joint selected workload and availability/recovery/privacy/security gates must pass before admission. No purchase or deployment performed by authoring this file."
