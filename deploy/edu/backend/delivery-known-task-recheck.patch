+func TestCompareKnownIssuesOnlyGetAndReportsChangedAttributes(t *testing.T) {
+	const marker = "[HITPIPE-HANDOFF:example:v1]"
+	target := Target{WorkspaceID: "12", ListID: "34", AssigneeID: "56", Title: "Accepted",
+		RenderedBlock: marker + "\nContext"}
+	calls := 0
+	row := map[string]any{"id": "task_123", "team_id": 12, "list": map[string]int{"id": 34},
+		"assignees": []map[string]int{{"id": 56}}, "name": target.Title, "description": target.RenderedBlock}
+	client, err := New(func(request *http.Request) (*http.Response, error) {
+		calls++
+		if request.Method != http.MethodGet || request.URL.Host != "api.clickup.com" ||
+			request.URL.Path != "/api/v2/task/task_123" || request.Body != nil {
+			t.Fatalf("unexpected provider operation: %v %v", request.Method, request.URL)
+		}
+		wire, err := json.Marshal(row)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(string(wire)))}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	compare := func() (Comparison, error) {
+		return client.CompareKnown(context.Background(), "fixture-credential", "task_123", target, marker)
+	}
+	if got, err := compare(); err != nil || !got.Workspace || !got.List || !got.Assignee || !got.Title || !got.Marker || !got.Context {
+		t.Fatalf("same task did not match: %+v %v", got, err)
+	}
+	row["name"] = "Changed"
+	row["description"] = "marker removed"
+	if got, err := compare(); err != nil || !got.Workspace || !got.List || !got.Assignee || got.Title || got.Marker || got.Context {
+		t.Fatalf("changed fields falsely verified: %+v %v", got, err)
+	}
+	row["id"] = "different_native_id"
+	if _, err := compare(); !errors.Is(err, ErrReadUnavailable) {
+		t.Fatalf("unexpected identity recognized: %v", err)
+	}
+	if calls != 3 {
+		t.Fatalf("want three protected known-ID reads, got %d", calls)
+	}
+}
