+package intake
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"mime"
+	"net/http"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+	"github.com/gowebpki/jcs"
+)
+
+const queryRoute = "/internal/v1/delivery-query"
+
+type Query struct {
+	Workspace, Case, Lineage uuid.UUID
+	Epoch                    int64
+	Deadline                 time.Time
+	TaskID                   string
+}
+
+type QueryReader interface {
+	QueryKnownTask(context.Context, Query) ([]byte, error)
+}
+
+func decodeQuery(raw []byte) (Query, error) {
+	var q Query
+	if !utf8.Valid(raw) {
+		return q, invalid{}
+	}
+	// Reject duplicate keys and invalid Unicode before interpreting identities.
+	if _, err := jcs.Transform(raw); err != nil {
+		return q, invalid{}
+	}
+	f, err := decodeObject(raw)
+	if err != nil || len(f) != 6 {
+		return q, invalid{}
+	}
+	for key, dst := range map[string]*uuid.UUID{
+		"workspace_id": &q.Workspace, "case_id": &q.Case, "lineage_id": &q.Lineage,
+	} {
+		*dst, err = parseUUID(f[key])
+		if err != nil {
+			return q, invalid{}
+		}
+	}
+	q.Epoch, err = exactEpoch(string(f["expected_connection_epoch"]))
+	if err != nil {
+		return q, invalid{}
+	}
+	q.Deadline, err = dateField(f["deadline_at"])
+	if err != nil {
+		return q, invalid{}
+	}
+	q.TaskID, err = stringField(f["native_task_id"], 1, 255)
+	if err != nil {
+		return q, invalid{}
+	}
+	return q, nil
+}
+
+// WithKnownTaskQuery mounts the read-only RECHECK operation on the same
+// private listener and with the same exact Processing certificate SAN.
+func WithKnownTaskQuery(next http.Handler, reader QueryReader, processingSAN string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != queryRoute {
+			next.ServeHTTP(w, r)
+			return
+		}
+		requestID := uuid.New()
+		fail := func(status int, code string) { writeFailure(w, status, code, requestID) }
+		if r.Method != http.MethodPost || r.URL.RawPath != "" || r.URL.RawQuery != "" || r.URL.ForceQuery {
+			fail(http.StatusBadRequest, "INVALID_QUERY")
+			return
+		}
+		if r.TLS == nil || r.TLS.Version != tls.VersionTLS13 || len(r.TLS.VerifiedChains) == 0 ||
+			len(r.TLS.VerifiedChains[0]) == 0 {
+			fail(http.StatusUnauthorized, "CERTIFICATE_REQUIRED")
+			return
+		}
+		if cert := r.TLS.VerifiedChains[0][0]; cert.VerifyHostname(processingSAN) != nil || !hasExactDNSName(cert, processingSAN) {
+			fail(http.StatusUnauthorized, "CALLER_DENIED")
+			return
+		}
+		ids := r.Header.Values("X-Request-ID")
+		if len(ids) != 1 {
+			fail(http.StatusBadRequest, "INVALID_REQUEST_ID")
+			return
+		}
+		id, err := uuid.Parse(ids[0])
+		if err != nil || id == uuid.Nil || len(ids[0]) != 36 {
+			fail(http.StatusBadRequest, "INVALID_REQUEST_ID")
+			return
+		}
+		requestID = id
+		medias := r.Header.Values("Content-Type")
+		if len(medias) != 1 || r.Header.Get("Content-Encoding") != "" {
+			fail(http.StatusBadRequest, "INVALID_CONTENT_TYPE")
+			return
+		}
+		media, _, err := mime.ParseMediaType(medias[0])
+		if err != nil || media != "application/json" {
+			fail(http.StatusBadRequest, "INVALID_CONTENT_TYPE")
+			return
+		}
+		raw, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 4096))
+		if err != nil {
+			var oversized *http.MaxBytesError
+			if errors.As(err, &oversized) {
+				fail(http.StatusRequestEntityTooLarge, "SIZE_LIMIT")
+			} else {
+				fail(http.StatusBadRequest, "INVALID_BODY")
+			}
+			return
+		}
+		q, err := decodeQuery(raw)
+		if err != nil {
+			fail(http.StatusBadRequest, "INVALID_QUERY")
+			return
+		}
+		body, err := reader.QueryKnownTask(r.Context(), q)
+		switch {
+		case err == nil:
+			w.Header().Set("Content-Type", "application/json")
+			w.Header().Set("Cache-Control", "no-store")
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write(body)
+		case errors.Is(err, ErrDenied):
+			fail(http.StatusForbidden, "SCOPE_DENIED")
+		case errors.Is(err, ErrNotFound):
+			fail(http.StatusNotFound, "NOT_FOUND")
+		case errors.Is(err, ErrStale):
+			fail(http.StatusPreconditionFailed, "STALE_QUERY")
+		default:
+			fail(http.StatusServiceUnavailable, "READBACK_UNAVAILABLE")
+		}
+	})
