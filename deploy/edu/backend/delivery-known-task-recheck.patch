+package intake
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type queryFunc func(context.Context, Query) ([]byte, error)
+
+func (f queryFunc) QueryKnownTask(ctx context.Context, q Query) ([]byte, error) { return f(ctx, q) }
+
+func TestKnownQueryRequiresProcessingCertificateAndExactKnownIdentity(t *testing.T) {
+	workspace, caseID, lineage := uuid.New(), uuid.New(), uuid.New()
+	body, err := json.Marshal(map[string]any{
+		"workspace_id": workspace, "case_id": caseID, "lineage_id": lineage,
+		"expected_connection_epoch": 7, "deadline_at": time.Now().UTC().Add(15 * time.Second),
+		"native_task_id": "known-123",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	handler := WithKnownTaskQuery(http.NotFoundHandler(), queryFunc(func(_ context.Context, q Query) ([]byte, error) {
+		calls++
+		if q.Workspace != workspace || q.Case != caseID || q.Lineage != lineage || q.Epoch != 7 || q.TaskID != "known-123" {
+			t.Fatalf("incorrect protected query: %+v", q)
+		}
+		return []byte(`{"knowledge":"RESULT_VERIFIED"}`), nil
+	}), "processing.test")
+	run := func(cert string, input string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(http.MethodPost, queryRoute, strings.NewReader(input))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-Request-ID", uuid.NewString())
+		if cert != "" {
+			req.TLS = &tls.ConnectionState{Version: tls.VersionTLS13,
+				VerifiedChains: [][]*x509.Certificate{{{DNSNames: []string{cert}}}}}
+		}
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, req)
+		return w
+	}
+	for _, cert := range []string{"", "delivery.test", "*.test"} {
+		if got := run(cert, string(body)).Code; got != http.StatusUnauthorized {
+			t.Fatalf("bad cert got status %d", got)
+		}
+	}
+	for _, invalidInput := range []string{
+		strings.Replace(string(body), `"native_task_id":"known-123"`, `"external_task":"known-123"`, 1),
+		strings.Replace(string(body), `"native_task_id":"known-123"`, `"native_task_id":"other","native_task_id":"known-123"`, 1),
+		strings.Replace(string(body), `"native_task_id":"known-123"`, `"native_task_id":null`, 1),
+	} {
+		if got := run("processing.test", invalidInput).Code; got != http.StatusBadRequest {
+			t.Fatalf("invalid query got %d", got)
+		}
+	}
+	if calls != 0 {
+		t.Fatalf("unqualified requests reached reader: %d", calls)
+	}
+	resp := run("processing.test", string(body))
+	if resp.Code != http.StatusOK || !strings.Contains(resp.Body.String(), "RESULT_VERIFIED") || calls != 1 {
+		t.Fatalf("qualified read not returned: %d %s (%d reads)", resp.Code, resp.Body.String(), calls)
+	}
+}
