+package demoworker
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/dkar-dev/hitpipe/services/delivery/internal/clickup"
+	"github.com/dkar-dev/hitpipe/services/delivery/internal/demoobservation"
+	"github.com/dkar-dev/hitpipe/services/delivery/internal/intake"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// KnownTaskReader serves rechecks with the same worker credentials and
+// application bindings. Its only provider operation is GET of the durable ID.
+type KnownTaskReader struct {
+	pool      *pgxpool.Pool
+	config    Config
+	gate      intake.StartGate
+	directory *intake.Directory
+	client    *clickup.Client
+}
+
+func (r *KnownTaskReader) QueryKnownTask(ctx context.Context, q intake.Query) ([]byte, error) {
+	cfg := r.config
+	if q.Workspace != cfg.WorkspaceID || q.Epoch != cfg.Epoch {
+		return nil, intake.ErrDenied
+	}
+	now := time.Now()
+	if !now.Before(q.Deadline) || q.Deadline.After(now.Add(30*time.Second)) {
+		return nil, intake.ErrStale
+	}
+	ctx, cancel := context.WithDeadline(ctx, q.Deadline)
+	defer cancel()
+	ctx, cancelRead := context.WithTimeout(ctx, 1800*time.Millisecond)
+	defer cancelRead()
+
+	var wire []byte
+	err := r.gate.WithOpen(ctx, q.Workspace, q.Epoch, func() error {
+		item, target, err := r.resolveKnown(ctx, q)
+		if err != nil {
+			return err
+		}
+		if ctx.Err() != nil || !time.Now().Before(item.ref.Expires) {
+			return intake.ErrStale
+		}
+		marker := "[HITPIPE-HANDOFF:" + q.Case.String() + ":v1]"
+		result, err := r.client.CompareKnown(ctx, syntheticCredential, q.TaskID, target, marker)
+		if err != nil {
+			return intake.ErrUnavailable
+		}
+		at := time.Now().UTC().Truncate(time.Microsecond)
+		if ctx.Err() != nil || !at.Before(item.ref.Expires) {
+			return intake.ErrStale
+		}
+		match := demoobservation.Readback{KnownTaskID: q.TaskID, TaskID: q.TaskID, ObservedAt: at, Complete: true,
+			WorkspaceMatches: result.Workspace, ListMatches: result.List, AssigneeMatches: result.Assignee,
+			TitleMatches: result.Title, MarkerMatches: result.Marker, ContextMatches: result.Context}
+
+		tx, err := scoped(ctx, r.pool, cfg)
+		if err != nil {
+			return intake.ErrUnavailable
+		}
+		defer tx.Rollback(ctx)
+		current, err := lockKnown(ctx, tx, cfg, q)
+		if err != nil {
+			return err
+		}
+		if current.attemptID != item.attemptID || current.episodeID != item.episodeID ||
+			current.ref.ID != item.ref.ID || current.ref.SHA256 != item.ref.SHA256 ||
+			!current.ref.Expires.Equal(item.ref.Expires) {
+			return intake.ErrStale
+		}
+		wire, err = saveKnownObservation(ctx, tx, r.directory, q.Workspace, item, target, match)
+		if err != nil || tx.Commit(ctx) != nil {
+			return intake.ErrUnavailable
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return wire, nil
+}
+
+func (r *KnownTaskReader) resolveKnown(ctx context.Context, q intake.Query) (job, clickup.Target, error) {
+	tx, err := scoped(ctx, r.pool, r.config)
+	if err != nil {
+		return job{}, clickup.Target{}, intake.ErrUnavailable
+	}
+	defer tx.Rollback(ctx)
+	item, err := lockKnown(ctx, tx, r.config, q)
+	if err != nil {
+		return job{}, clickup.Target{}, err
+	}
+	target, err := acceptedTarget(r.directory, r.config, item)
+	if err != nil {
+		return job{}, clickup.Target{}, intake.ErrDenied
+	}
+	if tx.Commit(ctx) != nil {
+		return job{}, clickup.Target{}, intake.ErrUnavailable
+	}
+	return item, target, nil
+}
+
+func lockKnown(ctx context.Context, tx pgx.Tx, cfg Config, q intake.Query) (job, error) {
+	var item job
+	// RLS is already scoped to the current workspace. The caller opens one
+	// transaction before the read and checks these pins again before saving.
+	err := tx.QueryRow(ctx, `SELECT l.case_id,l.lineage_id,a.episode_id,a.attempt_id,
+		c.rendered_payload_ref,c.rendered_payload_sha256,c.rendered_payload_bytes,c.expires_at
+	  FROM hp_delivery.effect_lineage l
+	  JOIN hp_delivery.attempts a USING(workspace_id,lineage_id)
+	  JOIN hp_delivery.intent_content c USING(workspace_id,attempt_id)
+	  JOIN hp_delivery.destination_connections d USING(workspace_id,connection_id)
+	  WHERE l.workspace_id=$1 AND l.connection_id=$2 AND d.external_workspace_id=$3
+	    AND l.case_id=$4 AND l.lineage_id=$5 AND l.known_task_id=$6
+	    AND l.state IN ('RESULT_ID_OBSERVED','TARGET_OBSERVED') AND l.ever_dispatch_fenced
+	    AND a.connection_epoch=$7 AND a.dispatch_fenced_at IS NOT NULL AND a.network_start_at IS NOT NULL
+	    AND d.security_epoch=$7 AND d.revoked_at IS NULL AND d.health='READY'
+	    AND c.expires_at>clock_timestamp()
+	  ORDER BY a.attempt_number DESC LIMIT 1 FOR SHARE OF l,d`,
+		cfg.WorkspaceID, cfg.ConnectionID, cfg.DestinationWorkspace, q.Case, q.Lineage, q.TaskID, q.Epoch).Scan(
+		&item.caseID, &item.lineageID, &item.episodeID, &item.attemptID, &item.ref.ID, &item.ref.SHA256, &item.ref.Size, &item.ref.Expires)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return item, intake.ErrNotFound
+	}
+	if err != nil {
+		return item, intake.ErrUnavailable
+	}
+	return item, nil
+}
+
+func saveKnownObservation(ctx context.Context, tx pgx.Tx, dir *intake.Directory, workspace uuid.UUID, item job,
+	target clickup.Target, match demoobservation.Readback) ([]byte, error) {
+	at := match.ObservedAt
+	expires := at.Add(time.Hour)
+	if item.ref.Expires.Before(expires) {
+		expires = item.ref.Expires.UTC().Truncate(time.Microsecond)
+	}
+	proof, err := json.Marshal(match)
+	if err != nil {
+		return nil, err
+	}
+	ref, err := dir.Put(proof, expires)
+	if err != nil {
+		return nil, err
+	}
+	scope := demoobservation.Scope{WorkspaceID: workspace, CaseID: item.caseID, LineageID: item.lineageID,
+		EpisodeID: item.episodeID, AttemptID: item.attemptID, MessageID: uuid.New(), ObservationID: uuid.New()}
+	message, err := demoobservation.BuildKnown(scope, match, ref)
+	if err != nil {
+		return nil, err
+	}
+	knowledge, code := "RESULT_VERIFIED", demoobservation.ProofCode
+	if !match.FullyMatches() {
+		knowledge, code = "RESULT_MISMATCH", demoobservation.MismatchProofCode
+	}
+	expected, err := json.Marshal(target)
+	if err != nil {
+		return nil, err
+	}
+	_, err = tx.Exec(ctx, `INSERT INTO hp_delivery.effect_observations(workspace_id,observation_id,lineage_id,attempt_id,knowledge,
+	    observed_at,proof_code,proof_digest,known_task_id) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)`,
+		workspace, scope.ObservationID, item.lineageID, item.attemptID, knowledge, at, code, ref.SHA256, match.KnownTaskID)
+	if err != nil {
+		return nil, err
+	}
+	_, err = tx.Exec(ctx, `INSERT INTO hp_delivery.observation_content(workspace_id,observation_id,actual_attributes_ref,
+	    actual_attributes_sha256,actual_attributes_bytes,expected_attributes_digest,created_at,expires_at)
+	    VALUES($1,$2,$3,$4,$5,$6,$7,$8)`, workspace, scope.ObservationID, ref.ID, ref.SHA256, ref.Size,
+		fmt.Sprintf("sha256:%x", sha256.Sum256(expected)), at, ref.Expires)
+	if err != nil {
+		return nil, err
+	}
+	return message.Wire, nil
+}
