+package runtime
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSourceFactsDeadline(t *testing.T) {
+	now := time.Unix(1000, 0)
+	later := now.Add(10 * time.Second)
+	for _, tc := range []struct {
+		name           string
+		school         bool
+		claim, episode time.Time
+		want           time.Duration
+	}{
+		{"normal", false, later, time.Time{}, 2 * time.Second},
+		{"school", true, later, time.Time{}, 5 * time.Second},
+		{"claim", true, now.Add(3 * time.Second), later, 3 * time.Second},
+		{"episode", true, later, now.Add(time.Second), time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := sourceFactsDeadline(now, tc.claim, tc.episode, tc.school); !got.Equal(now.Add(tc.want)) {
+				t.Fatalf("got %s, want %s", got.Sub(now), tc.want)
+			}
+		})
+	}
+}
