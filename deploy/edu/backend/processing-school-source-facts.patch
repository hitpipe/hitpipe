+
+func sourceFactsDeadline(now, claimUntil, episodeUntil time.Time, school bool) time.Time {
+	budget := protectedTime
+	if school {
+		budget = 5 * time.Second
+	}
+	deadline := now.Add(budget)
+	if claimUntil.Before(deadline) {
+		deadline = claimUntil
+	}
+	if !episodeUntil.IsZero() && episodeUntil.Before(deadline) {
+		deadline = episodeUntil
+	}
+	return deadline
+}
+
+type sourceReaderDiagnostics struct {
+	reader   evaluatepaidorder.SourceFactsReader
+	logger   *slog.Logger
+	deadline time.Time
+}
+
+func (r sourceReaderDiagnostics) Read(ctx context.Context, q evaluatepaidorder.Query) (evaluatepaidorder.Snapshot, error) {
+	snapshot, err := r.reader.Read(ctx, q)
+	if err != nil {
+		logSourceReadFailure(r.logger, "read", r.deadline, err)
+	}
+	return snapshot, err
+}
+
+func logSourceReadFailure(logger *slog.Logger, stage string, deadline time.Time, err error) {
+	if logger == nil {
+		return
+	}
+	kind, status := "UNCLASSIFIED", 0
+	var readErr *sourcefacts.ReadError
+	if errors.As(err, &readErr) {
+		kind, status = readErr.Kind, readErr.StatusCode
+	}
+	logger.Warn("school SourceFacts read unavailable", "stage", stage, "kind", kind,
+		"http_status", status, "deadline_elapsed", !time.Now().Before(deadline))
 }
 
