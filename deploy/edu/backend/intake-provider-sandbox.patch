+	handler, err := NewHandler(2*time.Second, sandboxInstallation{installation}, sandboxStart{}, map[string]*receivesignal.Consumer{workspace: receiver})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewTLSServer(handler)
+	defer server.Close()
+	raw := []byte(`{"id":"evt_provider_sandbox","object":"event","api_version":"2026-09-30.endive","created":1800000000,"livemode":false,"type":"checkout.session.completed","data":{"object":{"id":"cs_provider_sandbox","object":"checkout.session","created":1799999999,"livemode":false}}}`)
+	h := hmac.New(sha256.New, []byte("unit-provider-sandbox-signing-key"))
+	fmt.Fprintf(h, "%d.", now.Unix())
