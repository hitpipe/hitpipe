+package normalizesignal
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+)
+
+func sandboxFixture() Input {
+	in := fixture()
+	in.Binding.AccountScope = SandboxEndpointAccount
+	in.Binding.StripeAccountID = "acct_1UfGTDE1OQW8MuKn"
+	in.Binding.APIVersion = "2026-09-30.endive"
+	in.RawBody = []byte(strings.ReplaceAll(strings.ReplaceAll(string(in.RawBody), "acct_synthetic", in.Binding.StripeAccountID), "synthetic-version", in.Binding.APIVersion))
+	return in
+}
+
+func TestSandboxEndpointNormalizesSignedAbsentOrExactAccount(t *testing.T) {
+	for _, present := range []bool{false, true} {
+		in := sandboxFixture()
+		if !present {
+			in.RawBody = []byte(strings.Replace(string(in.RawBody), `"account":"`+in.Binding.StripeAccountID+`",`, "", 1))
+		}
+		before := append([]byte(nil), in.RawBody...)
+		out, err := execute(t, in)
+		if err != nil || out == nil || out.StripeAccountID != in.Binding.StripeAccountID || out.Livemode {
+			t.Fatalf("present=%v: %+v %v", present, out, err)
+		}
+		if !bytes.Equal(before, in.RawBody) {
+			t.Fatal("signed bytes were edited")
+		}
+	}
+}
+
+func TestSandboxEndpointRejectsForeignNullLiveAndVersion(t *testing.T) {
+	for name, mutate := range map[string]func(*Input){
+		"foreign account": func(in *Input) {
+			in.RawBody = []byte(strings.Replace(string(in.RawBody), in.Binding.StripeAccountID, "acct_foreign", 1))
+		},
+		"null account": func(in *Input) {
+			in.RawBody = []byte(strings.Replace(string(in.RawBody), `"account":"`+in.Binding.StripeAccountID+`"`, `"account":null`, 1))
+		},
+		"live event": func(in *Input) {
+			in.RawBody = []byte(strings.ReplaceAll(string(in.RawBody), `"livemode":false`, `"livemode":true`))
+		},
+		"live binding and event": func(in *Input) {
+			mode := true
+			in.Binding.Livemode = &mode
+			in.RawBody = []byte(strings.ReplaceAll(string(in.RawBody), `"livemode":false`, `"livemode":true`))
+		},
+		"wrong version": func(in *Input) {
+			in.RawBody = []byte(strings.Replace(string(in.RawBody), in.Binding.APIVersion, "2026-10-28.endive", 1))
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			in := sandboxFixture()
+			mutate(&in)
+			if out, err := execute(t, in); err == nil || out != nil {
+				t.Fatalf("accepted invalid sandbox event: %+v %v", out, err)
+			}
+		})
+	}
+}
+
+func TestSandboxEndpointStillAuthenticatesOriginalBytes(t *testing.T) {
+	in := sandboxFixture()
+	in.RawBody = []byte(strings.Replace(string(in.RawBody), `"account":"`+in.Binding.StripeAccountID+`",`, "", 1))
+	in.Signature = sign(in.RawBody)
+	c, err := New(&secrets{}, clock{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	in.RawBody = append(in.RawBody, ' ')
+	if out, err := c.Normalize(context.Background(), in); err == nil || out != nil {
+		t.Fatal("accepted modified signed bytes")
+	}
+}
