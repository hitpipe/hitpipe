+		_, _ = io.Copy(io.Discard, response.Body)
+		return response.StatusCode
+	}
+	if code := post(signature); code != http.StatusNoContent {
+		t.Fatalf("first request: %d", code)
+	}
+	first := *repo.stored
+	if code := post(signature); code != http.StatusNoContent {
+		t.Fatalf("duplicate request: %d", code)
+	}
+	if repo.inserts != 1 || *repo.stored != first || repo.stored.Signal.StripeAccountID != account || repo.stored.Signal.Livemode {
+		t.Fatal("duplicate changed durable identity")
+	}
+	sessions := repo.sessions
+	if code := post("t=1800000000,v1=" + hex.EncodeToString(make([]byte, 32))); code != http.StatusUnauthorized {
+		t.Fatalf("bad signature: %d", code)
+	}
+	if repo.sessions != sessions || repo.inserts != 1 {
+		t.Fatal("unauthenticated duplicate reached receipt storage")
+	}
+}
