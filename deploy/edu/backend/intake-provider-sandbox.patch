+func providerConfig() map[string]any {
+	return map[string]any{"profile": "provider-sandbox", "listen": "127.0.0.1:28443", "database_port": 5432,
+		"stripe_origin": "https://127.0.0.1:18445", "processing_address": "127.0.0.1:8443", "batch": 1,
+		"poll_ms": 125, "qualification_epoch": 7, "qualification_workspace_id": "c71a0e98-fab0-46dd-9742-9f592802bd26",
+		"sandbox_account_id": ProviderSandboxAccount, "sandbox_api_version": ProviderSandboxVersion}
+}
+
+func loadConfig(t *testing.T, value map[string]any) (Config, error) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "intake.json")
+	if err := os.WriteFile(path, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return Load(path)
+}
+
+func TestProviderSandboxScopeAndLoopbackAreExplicit(t *testing.T) {
+	c, err := loadConfig(t, providerConfig())
+	if err != nil || c.SandboxAccountID != ProviderSandboxAccount || c.SandboxAPIVersion != ProviderSandboxVersion {
+		t.Fatal(c, err)
+	}
+	for name, change := range map[string]func(map[string]any){
+		"missing account":     func(v map[string]any) { delete(v, "sandbox_account_id") },
+		"foreign account":     func(v map[string]any) { v["sandbox_account_id"] = "acct_foreign" },
+		"missing version":     func(v map[string]any) { delete(v, "sandbox_api_version") },
+		"fixture version":     func(v map[string]any) { v["sandbox_api_version"] = Version },
+		"missing workspace":   func(v map[string]any) { delete(v, "qualification_workspace_id") },
+		"nil workspace":       func(v map[string]any) { v["qualification_workspace_id"] = "00000000-0000-0000-0000-000000000000" },
+		"missing epoch":       func(v map[string]any) { delete(v, "qualification_epoch") },
+		"external origin":     func(v map[string]any) { v["stripe_origin"] = "https://api.stripe.com" },
+		"external listener":   func(v map[string]any) { v["listen"] = "0.0.0.0:8443" },
+		"injected LIVE field": func(v map[string]any) { v["livemode"] = true },
+		"sandbox cannot adopt account": func(v map[string]any) {
+			v["profile"] = "sandbox"
+			delete(v, "qualification_epoch")
+			delete(v, "qualification_workspace_id")
+		},
+		"qualification cannot adopt account": func(v map[string]any) { v["profile"] = "qualification" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			v := providerConfig()
+			change(v)
+			if _, e := loadConfig(t, v); !errors.Is(e, ErrConfig) {
+				t.Fatalf("expected closed configuration: %v", e)
+			}
+		})
+	}
+}
+
+func TestProviderSandboxBindingPropagatesWithoutChangingFixtures(t *testing.T) {
+	s := &sandbox{ctx: context.Background(), workspace: Workspace, epoch: 7,
+		providerAccount: ProviderSandboxAccount, providerVersion: ProviderSandboxVersion}
+	b := s.connection().Binding
+	if b.StripeAccountID != ProviderSandboxAccount || b.APIVersion != ProviderSandboxVersion || b.AccountScope != normalizesignal.SandboxEndpointAccount || b.Livemode == nil || *b.Livemode {
+		t.Fatalf("wrong endpoint binding: %+v", b)
+	}
+	if s.binding().AccountID != ProviderSandboxAccount || s.binding().APIVersion != ProviderSandboxVersion || s.scope().Account != ProviderSandboxAccount {
+		t.Fatal("provider identity lost in facts/outbox")
+	}
+	s.providerAccount, s.providerVersion = "", ""
+	b = s.connection().Binding
+	if b.StripeAccountID != Account || b.APIVersion != Version || b.AccountScope != normalizesignal.ConnectedAccount || s.binding().AccountID != Account || s.scope().Account != Account {
+		t.Fatal("fixture contract changed")
+	}
+}
