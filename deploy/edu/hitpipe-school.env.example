# Скопируйте в ~/.config/hitpipe-school.env и подставьте абсолютные пути.
HITPIPE_SCHOOL_CODE=/absolute/path/to/hitpipe
HITPIPE_SCHOOL_STATE=/absolute/path/to/private/runtime
HITPIPE_SCHOOL_BACKEND=/absolute/path/to/run-school-backend.sh
HITPIPE_SCHOOL_EVENT=/absolute/path/to/emit-school-event.sh
HITPIPE_DEMO_SOURCE=/absolute/path/to/unpacked/demo-sources
HITPIPE_SCHOOL_FRONTEND=/absolute/path/to/hitpipe_client/tooling/pr12/frontend
HITPIPE_NODE=/absolute/path/to/node
HITPIPE_GO=/absolute/path/to/go
HITPIPE_SCHOOL_INSTANCE=edu
HITPIPE_BROWSER_PORT=3108
HITPIPE_SCHOOL_ENTRY_PORT=3109
# Установите 1 после сборки интерфейса с учебным помощником.
HITPIPE_SCHOOL_AI=0
# Включайте после установки совместимых интерфейса и учебного бэкенда.
HITPIPE_SCHOOL_STRIPE_EVENTS=0
# Укажите свой каталог Chromium, если Playwright установлен не в стандартный кэш.
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/playwright-browsers
